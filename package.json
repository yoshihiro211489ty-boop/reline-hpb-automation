{
  "name": "reline-hpb-automation",
  "version": "1.0.0",
  "description": "リライン HPB集客自動化システム",
  "main": "dist/orchestrator.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/orchestrator.js",
    "dry-run": "DRY_RUN=1 node dist/orchestrator.js",
    "dry-run:review": "DRY_RUN=1 node dist/orchestrator.js --agents=reviewWatcher,safetyClassifier,replyDrafter",
    "dry-run:blog": "DRY_RUN=1 node dist/orchestrator.js --agents=blogIdeator,blogWriter,blogPoster",
    "test:line": "node dist/scripts/test-line.js",
    "test:salonboard": "node dist/scripts/test-salonboard.js",
    "db:init": "node dist/scripts/db-init.js",
    "dev": "ts-node src/orchestrator.ts",
    "dev:dry": "DRY_RUN=1 ts-node src/orchestrator.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.54.0",
    "@line/bot-sdk": "^9.6.0",
    "cheerio": "^1.0.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "eta": "^3.5.0",
    "p-retry": "^6.2.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.60.0",
    "split2": "^4.2.0",
    "yaml": "^2.7.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
